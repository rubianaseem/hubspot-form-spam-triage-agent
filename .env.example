# Optional. Without it the agent uses its built-in rules and templates.
ANTHROPIC_API_KEY=
# Optional: override the model (see https://platform.claude.com/docs/en/about-claude/models/overview)
ANTHROPIC_MODEL=claude-sonnet-5-5
# Score thresholds (0-100). At or above REVIEW_AT = review, at or above SPAM_AT = likely spam.
REVIEW_AT=30
SPAM_AT=60
# Velocity rule: this many submissions on one form inside the window (minutes) is a burst.
BURST_COUNT=3
BURST_MINUTES=10
# Comma-separated countries you sell into. Leave blank to skip the geography signal.
TARGET_COUNTRIES=United Kingdom,Ireland,United States,Germany,Netherlands,Nigeria
